<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinUIRichEditor.Demo</RootNamespace>
    <CsWinRTIncludes>Microsoft.Graphics.Canvas</CsWinRTIncludes>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Unpackaged (no MSIX). Self-bootstraps the Windows App Runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinUIRichEditor\WinUIRichEditor.csproj" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>

  <!-- REMOVED (2026-07-25): _StripStaleWinAppSdkRuntimePri. It dropped WinUI 1.8.x runtime PRIs before
       the self-contained merge to avoid PRI277 'TextCommandDescriptionCopy'. Win2D 1.4.0 still declares a
       WinUI 1.8.x FLOOR (see its nuspec), but both projects now reference WindowsAppSDK 2.3.x explicitly,
       so NuGet resolves well above 1.8 and no 1.8 PRI ever reaches the merge. Verified empirically: the
       AOT self-contained publish succeeds with the target disabled. If the explicit WindowsAppSDK
       reference is ever dropped, Win2D's floor pulls 1.8 back in and this conflict can return. -->

  <!-- Deployment diet (publish only): drop the Windows-ML stack (onnxruntime.dll ~21MB +
       DirectML.dll ~18MB) that the WinAppSDK self-contained runtime bundles for AI APIs this
       editor never calls and never loads (confirmed absent from the running process' module list).
       The ~64MB AOT .pdb is handled separately via CopyOutputSymbolsToPublishDirectory in the
       publish profile. Together these save ~101MB. -->
  <Target Name="_TrimUnusedWindowsMlRuntime" AfterTargets="Publish">
    <ItemGroup>
      <_DietFile Include="$(PublishDir)onnxruntime.dll" />
      <_DietFile Include="$(PublishDir)DirectML.dll" />
    </ItemGroup>
    <Delete Files="@(_DietFile)" />
    <Message Importance="high" Text="Deployment diet: trimmed Windows-ML runtime DLLs from $(PublishDir)" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinUIRichEditor.Demo</RootNamespace>
    <CsWinRTIncludes>Microsoft.Graphics.Canvas</CsWinRTIncludes>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Unpackaged (no MSIX). Self-bootstraps the Windows App Runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinUIRichEditor\WinUIRichEditor.csproj" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>

  <!-- REMOVED (2026-07-25): _StripStaleWinAppSdkRuntimePri. It dropped WinUI 1.8.x runtime PRIs before
       the self-contained merge to avoid PRI277 'TextCommandDescriptionCopy'. Win2D 1.4.0 still declares a
       WinUI 1.8.x FLOOR (see its nuspec), but both projects now reference WindowsAppSDK 2.3.x explicitly,
       so NuGet resolves well above 1.8 and no 1.8 PRI ever reaches the merge. Verified empirically: the
       AOT self-contained publish succeeds with the target disabled. If the explicit WindowsAppSDK
       reference is ever dropped, Win2D's floor pulls 1.8 back in and this conflict can return. -->

  <!-- Deployment diet (publish only). The self-contained WinAppSDK runtime bundles the whole platform,
       including feature stacks a text editor never touches. Each entry below was verified the same way:
       run the published app, enumerate the process' loaded modules, and confirm the DLL is absent — then
       delete it, re-run, and confirm the app still starts and renders.

       Windows-ML (~39MB): onnxruntime + DirectML, for AI APIs this editor never calls.
       Feature stacks (~7.7MB): the WebView2/AI/Widgets set the WinAppSDK METAPACKAGE drags in. The
       library itself avoids the metapackage for exactly this reason (see CLAUDE.md), but an app that
       publishes self-contained must reference it — Microsoft.WindowsAppSDK.Runtime ships only there —
       so the app pays, and trims here instead.

       The ~64MB AOT .pdb is handled separately (CopyOutputSymbolsToPublishDirectory in the publish
       profile). Together: ~110MB, and the publish folder lands at ~78MB.

       NOT trimmed, and why: .pri / .winmd (~7MB) are read as resources and metadata, never LoadLibrary'd,
       so the module-list check says nothing about them — absence from it is not evidence. DWriteCore.dll
       likewise showed as unloaded but is the text stack; not worth the risk. (The .mui files are in the
       same category and ARE now trimmed — by a different kind of evidence: see part 2 below.) -->
  <Target Name="_TrimUnusedRuntimeStacks" AfterTargets="Publish">
    <ItemGroup>
      <!-- Windows-ML -->
      <_DietFile Include="$(PublishDir)onnxruntime.dll" />
      <_DietFile Include="$(PublishDir)DirectML.dll" />
      <!-- Widgets / WebView2 / on-device AI -->
      <_DietFile Include="$(PublishDir)Microsoft.Windows.Widgets.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Web.WebView2.Core.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Windows.AI.MachineLearning.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Windows.AI.Text.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Windows.AI.Imaging.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Windows.AI.Video.dll" />
      <_DietFile Include="$(PublishDir)PerceptiveStreaming.dll" />
      <!-- Development artefacts of the referenced library (~0.35MB): the XML docs are IntelliSense for
           whoever COMPILES against it, and the .pdb belongs to a managed assembly that an AOT publish
           does not even ship. Neither is reachable at runtime. -->
      <_DietFile Include="$(PublishDir)WinUIRichEditor.xml" />
      <_DietFile Include="$(PublishDir)WinUIRichEditor.pdb" />
    </ItemGroup>
    <Delete Files="@(_DietFile)" />
    <Message Importance="high" Text="Deployment diet: trimmed unused runtime stacks from $(PublishDir)" />
  </Target>

  <!-- Deployment diet, part 2 (publish only): the self-contained WinAppSDK runtime ships its localized
       resources for 86 languages — 172 .mui files, ~3.4MB — and an app ships in the languages it has UI
       for. This library has exactly two (see RichEditorLocalization: "en" and "ko"), and the demo's own
       chrome is Korean, so en-us + ko-KR is the whole set. en-us stays regardless: it is the fallback
       MRM lands on for any language not present.

       Set $(ShippedLanguages) to change the list; set it empty to keep all of them.

       ⚠ This is the ONE trim in this file that the loaded-module check cannot justify — .mui files are
       read as resources, never LoadLibrary'd, so their absence from the module list means nothing (see
       the note above). It was verified the only way that works: publish, delete, RUN the app, and
       capture the window (tools\capture-window.ps1). 78.03MB -> 74.39MB, renders identically, Korean
       chrome intact.

       NOT trimmed: the ~2.7MB of .winmd. Deleting those also runs and renders — but .winmd is WinRT
       METADATA resolved lazily (RoGetMetaDataFile) for activation and reflection, so a first screen that
       draws proves nothing about the file picker, the print dialog or any other path that activates a
       type it did not need to draw a paragraph. Absence of evidence, again. -->
  <PropertyGroup>
    <ShippedLanguages Condition="'$(ShippedLanguages)' == ''">en-us;ko-KR</ShippedLanguages>
  </PropertyGroup>

  <Target Name="_TrimUnshippedLanguages" AfterTargets="Publish" Condition="'$(ShippedLanguages)' != ''">
    <ItemGroup>
      <_ShippedLanguage Include="$(ShippedLanguages)" />
      <!-- Every per-language .mui the runtime laid down, minus the ones we ship (Exclude expands the
           wildcards in the kept patterns, so this is a set difference, not a string compare). -->
      <_KeptMui Include="@(_ShippedLanguage->'$(PublishDir)%(Identity)\*.mui')" />
      <_DropMui Include="$(PublishDir)*\*.mui" Exclude="@(_KeptMui)" />
      <_DropLangDir Include="@(_DropMui->'%(RootDir)%(Directory)'->Distinct())" />
    </ItemGroup>
    <Delete Files="@(_DropMui)" />
    <!-- Their folders hold nothing else; leaving 84 empty directories behind is not a diet. -->
    <RemoveDir Directories="@(_DropLangDir)" />
    <Message Importance="high" Text="Deployment diet: kept only $(ShippedLanguages) of the runtime's localized resources" />
  </Target>
</Project>

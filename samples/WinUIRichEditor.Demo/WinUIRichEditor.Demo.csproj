<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinUIRichEditor.Demo</RootNamespace>
    <CsWinRTIncludes>Microsoft.Graphics.Canvas</CsWinRTIncludes>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Unpackaged (no MSIX). Self-bootstraps the Windows App Runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinUIRichEditor\WinUIRichEditor.csproj" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>

  <!-- REMOVED (2026-07-25): _StripStaleWinAppSdkRuntimePri. It dropped WinUI 1.8.x runtime PRIs before
       the self-contained merge to avoid PRI277 'TextCommandDescriptionCopy'. Win2D 1.4.0 still declares a
       WinUI 1.8.x FLOOR (see its nuspec), but both projects now reference WindowsAppSDK 2.3.x explicitly,
       so NuGet resolves well above 1.8 and no 1.8 PRI ever reaches the merge. Verified empirically: the
       AOT self-contained publish succeeds with the target disabled. If the explicit WindowsAppSDK
       reference is ever dropped, Win2D's floor pulls 1.8 back in and this conflict can return. -->

  <!-- Deployment diet (publish only). The self-contained WinAppSDK runtime bundles the whole platform,
       including feature stacks a text editor never touches. Each entry below was verified the same way:
       run the published app, enumerate the process' loaded modules, and confirm the DLL is absent — then
       delete it, re-run, and confirm the app still starts and renders.

       Windows-ML (~39MB): onnxruntime + DirectML, for AI APIs this editor never calls.
       Feature stacks (~7.7MB): the WebView2/AI/Widgets set the WinAppSDK METAPACKAGE drags in. The
       library itself avoids the metapackage for exactly this reason (see CLAUDE.md), but an app that
       publishes self-contained must reference it — Microsoft.WindowsAppSDK.Runtime ships only there —
       so the app pays, and trims here instead.

       The ~64MB AOT .pdb is handled separately (CopyOutputSymbolsToPublishDirectory in the publish
       profile). Together: ~110MB, and the publish folder lands at ~78MB.

       NOT trimmed, and why: .mui / .pri / .winmd (~10MB) are read as resources and metadata, never
       LoadLibrary'd, so the module-list check says nothing about them — absence from it is not evidence.
       DWriteCore.dll likewise showed as unloaded but is the text stack; not worth the risk. -->
  <Target Name="_TrimUnusedRuntimeStacks" AfterTargets="Publish">
    <ItemGroup>
      <!-- Windows-ML -->
      <_DietFile Include="$(PublishDir)onnxruntime.dll" />
      <_DietFile Include="$(PublishDir)DirectML.dll" />
      <!-- Widgets / WebView2 / on-device AI -->
      <_DietFile Include="$(PublishDir)Microsoft.Windows.Widgets.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Web.WebView2.Core.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Windows.AI.MachineLearning.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Windows.AI.Text.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Windows.AI.Imaging.dll" />
      <_DietFile Include="$(PublishDir)Microsoft.Windows.AI.Video.dll" />
      <_DietFile Include="$(PublishDir)PerceptiveStreaming.dll" />
    </ItemGroup>
    <Delete Files="@(_DietFile)" />
    <Message Importance="high" Text="Deployment diet: trimmed unused runtime stacks from $(PublishDir)" />
  </Target>
</Project>

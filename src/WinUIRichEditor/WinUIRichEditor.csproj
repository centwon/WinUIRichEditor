<!-- TreatAsLocalProperty: 호스트 앱(NewSchool)이 `dotnet publish` 로 AOT/트림 게시하면
     PublishTrimmed·PublishAot·PublishReadyToRun·RID 가 프로젝트 그래프 전체에 '전역 속성'으로
     적용된다. 전역 속성은 일반 할당으로 못 덮으므로(빌드 로그: "전역 속성이므로 수정할 수 없습니다"),
     이 라이브러리에서 로컬 재정의를 허용해 자체 ILLink/R2R 게시 후처리를 끈다(아래 PropertyGroup).
     라이브러리에 ILLink 가 단독 실행되면 엔트리포인트가 없어 IL1034 로 실패하기 때문이다.
     호스트의 AOT/트림은 WinUIRichEditor.dll 을 입력 어셈블리로 함께 처리하므로 영향 없다. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishTrimmed;PublishReadyToRun;PublishAot;PublishSingleFile">
  <PropertyGroup Label="Globals">
    <!-- Now that WinUI/WindowsAppSDK is referenced directly (see below), use the CsWinRT projection flavor
         of WebView2 like the host apps do. Leaving this False forces WebView2's plain-.NET branch, which
         references Microsoft.Web.WebView2.Wpf.dll (net5-windows → WindowsBase 5.0.0.0) and conflicts with
         the framework's WindowsBase 4.0.0.0 (MSB3277). True selects the projection-only reference. -->
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
  </PropertyGroup>
  <!-- 자체 게시 후처리(ILLink/R2R) 비활성화. 위 TreatAsLocalProperty 덕분에 전역값을 로컬로 덮을 수 있다. -->
  <PropertyGroup>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <!-- NuGet 패키지 메타데이터. 버전은 태그(release)로 덮어쓸 수 있게 CI에서 -p:Version 전달 가능. -->
  <PropertyGroup Label="Packaging">
    <PackageId>WinUIRichEditor</PackageId>
    <Version>1.3.0</Version>
    <Authors>centwon</Authors>
    <Company>centwon</Company>
    <Product>WinUIRichEditor</Product>
    <Title>WinUIRichEditor</Title>
    <Description>A from-scratch rich text editor control for WinUI 3, rendered with Win2D (CanvasVirtualControl / CanvasTextLayout). A port of AvaloniaRichEditor: text/paragraph formatting, tables (nested, colspan/rowspan, resize), inline &amp; block images, hyperlinks, undo/redo, CJK/Korean IME, clipboard (rich/HTML/RTF), page view, print/PDF, find, and drop-in host controls. Byte-compatible .flow document format. Native AOT ready.</Description>
    <Copyright>Copyright (c) 2026 centwon</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/centwon/WinUIRichEditor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/centwon/WinUIRichEditor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>winui;winui3;win2d;richtextbox;richtext;rich-text-editor;editor;wysiwyg;flowdocument;rtf;directwrite</PackageTags>
    <PackageReleaseNotes>See CHANGELOG.md. 1.3.0 ADDS PUBLIC API ONLY -- nothing removed or changed in signature, so upgrading needs no code edits. New: page margins as a document setting (PageMargins in millimetres, PageSetup.Margin/DefaultMargin/PaperMillimetres/DipsPerMm, RichEditor.PageMargin, saved in JSON/.flow and read and written by RTF together with the paper size); table row/column commands a host can call (InsertTableRow/DeleteTableRow/InsertTableColumn/DeleteTableColumn and the caret-relative InsertRowAbove/InsertRowBelow/DeleteRow/InsertColumnLeft/InsertColumnRight/DeleteColumn -- one undo step each, false when nothing changed); the shortcut table (RichEditorShortcuts.All/Display, RichEditorShortcutId, RichEditorShortcut); Block.AutoTopMargin; a quote button and a five-step margin picker in the toolbar. BEHAVIOUR CHANGES: (1) the page margin is 15 mm on every side unless the document says otherwise -- it used to be a fixed 48 x 40 DIP, so page view, printing and PDF lay out slightly differently. (2) New tables, pictures and dividers sit one line below the text above them (Block.MarginTop defaults to NaN = AutoTopMargin; a host reading MarginTop must expect NaN). Saved files are unaffected: 1.2 always wrote the margin, and a written value, 0 included, is kept. (3) A block inserted at the very start or end of a paragraph goes before or after it instead of splitting it. (4) Tab in the last cell of ANY table adds a row (it used to jump to the next table). (5) Commands that change nothing no longer leave an undo step or mark the document modified. (6) Empty paragraphs are written to HTML with a br so other apps show the blank line, and a cell holding a picture writes its paragraphs as elements. SECURITY: pasted HTML never reads pictures from network shares (an SMB connection could present the user&apos;s NTLM credentials), and javascript:/vbscript:/data: links are dropped on every input path -- HTML, RTF HYPERLINK fields, JSON and .flow -- and never written to HTML. Fixed: copy and paste failing silently while a clipboard watcher (Win+V history, a clipboard manager) briefly held the clipboard (6% of pastes measured), table API edits leaving a removed object selected, RTF margins not coming back to their millimetre value, empty list items lost in an HTML round trip, a text drag that lost pointer capture being dropped by the next click. Memory: pictures far from the viewport release their decode (a 100-photo document read to the end: 501 MB -&gt; 257 MB), the layout cache no longer grows with scrolling, an editor taken out of the visual tree releases its layouts and far pictures, the Win2D device is trimmed after releases, and the font list no longer opens every installed font (+31.6 MB -&gt; +0.7 MB). Verification: 815 -&gt; 953 tests, every fix falsified, JIT and Native AOT builds compared byte for byte on the same editing sequence.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- pack 은 명시적으로만(테스트/데모는 pack 대상 아님). CI 에서 이 프로젝트만 pack. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup Label="Packaging">
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinUIRichEditor</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- WinUI 클래스 라이브러리가 자체 .pri 를 생성하도록 함. 없으면 호스트 앱(NewSchool)의
         PRI 생성 단계가 WinUIRichEditor.pri 를 못 찾아 PRI252 발생(특히 Release). -->
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Ship the XML docs in the package: the library is heavily commented, and without this none of it
         reaches a consumer's IntelliSense. CS1591 ("missing XML comment") stays off — the public surface
         is documented, but the analyzer also flags members we deliberately leave to their summary. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- RID-specific 호스트 앱(예: NewSchool, win-x64)이 ProjectReference 로 참조할 때
         라이브러리 복원이 win-x64 대상을 생성하도록 RID 선언. VS 솔루션 복원에서
         NETSDK1047('...win-x64 대상이 없습니다') 방지. 출력 경로는
         AppendRuntimeIdentifierToOutputPath=false 라 RID 하위폴더 없이 유지됨. -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Native AOT readiness: surface trim/AOT warnings from the library itself. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- For RichEditorPrintHelper: the print dialog is called through its COM vtable with function
         pointers — the one AOT-safe route (the projection's generic result needs reflection). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>

    <!-- RichEditorDiagnostics reports fault locations via [CallerFilePath], which the compiler bakes in
         as a string literal — the FULL path on the build machine. That put ~17KB of
         "C:\Users\<whoever>\...\src\WinUIRichEditor\Controls\*.cs" into the shipped assembly, and with it
         the builder's username and directory layout. Release builds rewrite the repo root to a short
         token: same file:line diagnostics, a fraction of the bytes, nothing about the build machine.
         Debug keeps real paths so local stepping and IDE navigation are unaffected. -->
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)=/_/</PathMap>

    <!-- Win2D is platform-specific (C++). This library targets x64 only so it matches its
         x64 host apps (e.g. NewSchool) directly — no AnyCPU↔x64 platform negotiation, which
         avoids VS building it to bin\Debug (AnyCPU) and the host hitting CS0006. -->
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
    <Platforms>x64</Platforms>
    <!-- Coerce an empty/AnyCPU invocation (e.g. VS dependency build of a ProjectReference) to x64
         so output always lands in bin\x64\Debug where x64 consumers resolve it. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <!-- LOAD-BEARING, do not drop. Win2D 1.4.0 declares a *floor* of Microsoft.WindowsAppSDK.WinUI
         1.8.260204000 (its nuspec), so without this a standalone library/test restore resolves 1.8.x —
         validating the library on a different SDK than the apps run on, and re-introducing the PRI277
         self-contained merge conflict a build target used to work around (that target is gone: see the
         demo csproj). We lift just the WinUI component rather than the full Microsoft.WindowsAppSDK
         meta-package: the library only needs the WinUI/Win2D surface, and the meta-package drags WebView2
         (WPF flavor → WindowsBase 4/5 conflict warning), AI, ML, and Widgets we never use.
         This version is the package's declared MINIMUM for consumers, and it must satisfy TWO rules:
         (1) Keep it at the LOWEST version the library actually builds, tests and AOT-publishes on —
             raising it is breaking (a consumer on an older WindowsAppSDK cannot install the package).
         (2) It must not EXCEED the WinUI version the consumer's Microsoft.WindowsAppSDK meta-package
             brings (2.2.0 → WinUI 2.2.1; 2.3.1 → WinUI 2.3.0). A framework-dependent app otherwise
             compiles against a newer WinUI than the runtime it ships on. 0.9.0 shipped 2.3.2 — above
             what meta-package 2.3.1 provides — and broke exactly that; 0.9.1 lowered it back.
         Verified at 2.2.1: solution builds 0/0, tests 74/74, AOT self-contained publish runs and
         renders. Re-verify before changing. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <!-- Tracks the public surface in PublicAPI.*.txt so any change to it shows up as a diff instead of
         slipping out in a release. Analyzer-only: nothing is added to the package. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinUIRichEditor.Tests" />
  </ItemGroup>
</Project>
